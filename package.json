{
  "name": "interview-fit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "proxy": "node --experimental-strip-types --disable-warning=ExperimentalWarning services/proxy/src/main.ts",
    "demo:photo": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-demo-photo.ts",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json && tsc -p tsconfig.integration.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:privacy": "vitest run privacy",
    "test:policy": "vitest run policy",
    "test:a11y": "vitest run a11y",
    "test:contracts": "vitest run packages/contracts",
    "test:proxy": "vitest run services/proxy",
    "preview": "vite preview",
    "verify:harness": "node scripts/verify-harness.mjs",
    "verify:secrets": "node scripts/scan-repo.mjs",
    "verify:fast": "npm run verify:harness && npm run verify:secrets && npm run typecheck && npm run test",
    "verify:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run verify:fast && npm run build && npm run verify:rust",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
