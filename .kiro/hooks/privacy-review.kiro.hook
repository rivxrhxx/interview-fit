{
  "enabled": true,
  "name": "Privacy boundary review",
  "description": "Review sensitive boundary changes for leaks and excessive permissions.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["src-tauri/**", "services/proxy/**", "src/features/capture/**", "src/features/consent/**"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Apply .kiro/prompts/privacy-review.md to the current diff. Do not make silent security tradeoffs."
  }
}
